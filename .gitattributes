# Keep the repository in LF so code builds the same from Windows/WSL/Linux.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sln   text eol=crlf
*.vcxproj        text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user   text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.7z    binary
*.gz    binary
